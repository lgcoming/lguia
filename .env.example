# Public base URL used for canonical URLs, sitemap, robots and Open Graph.
# Falls back to the Vercel production URL, then to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enables GET /api/leads and /admin/leads in production builds.
# Only for demo deployments: there is no authentication yet and leads are stored in memory.
ENABLE_DEMO_ADMIN=false
