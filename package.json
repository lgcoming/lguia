{
  "name": "lguia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/in-real-path.mjs next dev",
    "build": "node scripts/in-real-path.mjs next build",
    "start": "node scripts/in-real-path.mjs next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/in-real-path.mjs playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run test",
    "preview": "node scripts/in-real-path.mjs \"opennextjs-cloudflare build && opennextjs-cloudflare preview\"",
    "deploy": "node scripts/in-real-path.mjs \"opennextjs-cloudflare build && opennextjs-cloudflare deploy\""
  },
  "dependencies": {
    "lucide-react": "^1.49.0",
    "motion": "^13.5.0",
    "next": "16.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.17",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "wrangler": "4.162.0"
  },
  "description": "LGuIA — digital agency platform: web, automation and practical AI for SMEs.",
  "engines": {
    "node": ">=22.12",
    "npm": ">=11.19.0"
  }
}
