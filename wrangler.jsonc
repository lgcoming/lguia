// Cloudflare Workers deployment (SPEC-010). Build and deploy with `npm run deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lguia",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // Self-reference used by OpenNext for internal requests.
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "lguia" }],
  // next/image optimisation through Cloudflare Images.
  "images": { "binding": "IMAGES" },
  // Lead notifications. Without restrictions the binding sends only to destination addresses
  // verified in Email Routing; the recipient is the LEADS_TO secret, so no personal address is
  // committed (`npx wrangler secret put LEADS_TO`).
  "send_email": [{ "name": "LEADS_EMAIL" }],
  "routes": [
    { "pattern": "lguia.com", "custom_domain": true },
    { "pattern": "www.lguia.com", "custom_domain": true },
  ],
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": true,
  "observability": { "enabled": true },
}
